{
    "name": "jorisnoo/craft-modules",
    "description": "Shared Craft CMS modules for control panel customization, deployment, and workflow automation.",
    "type": "craft-module",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "module"
    ],
    "authors": [
        {
            "name": "Joris Noordermeer",
            "email": "contact@noordermeer.ch",
            "homepage": "https://github.com/jorisnoo"
        }
    ],
    "autoload": {
        "psr-4": {
            "Noo\\CraftModules\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.9.0",
        "jorisnoo/craft-sitemap": "^1.0.0",
        "jorisnoo/craft-remote-sync": "^2.0.0",
        "jorisnoo/craft-seo-preview": "^1.0.0",
        "jorisnoo/craft-twig-helpers": "^1.0.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18.1",
        "pestphp/pest": "^3.8 || ^4.4",
        "webhubworks/craft-ohdear": "^5.7.2"
    },
    "scripts": {
        "lint": "pint"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
